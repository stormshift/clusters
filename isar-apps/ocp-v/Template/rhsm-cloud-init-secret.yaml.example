# One-time per OpenShift project (namespace). All vuln-scan VMs in the project reference
# this Secret via cloudInitNoCloud.secretRef. KubeVirt requires the key name "userdata".
#
#   cp rhsm-cloud-init-secret.yaml.example rhsm-cloud-init-secret.yaml
#   # edit activation-key, org, and add your SSH public key
#   oc apply -f rhsm-cloud-init-secret.yaml
#
# Or from a cloud-init file:
#
#   oc create secret generic rhsm-cloud-init -n <your-namespace> \
#     --from-file=userdata=cloud-init.yaml
#
apiVersion: v1
kind: Secret
metadata:
  name: rhsm-cloud-init
  namespace: REPLACE_ME
type: Opaque
stringData:
  userdata: |
    #cloud-config
    user: cloud-user
    ssh_pwauth: true
    chpasswd: { expire: False }
    ssh_authorized_keys:
      - ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIJ6TCuwHwdK4IQrtLEIwZgopQgaIALn0shN+nJqcBwLl ansible@security-aap
      - ssh-ed25519 AAAA... REPLACE_WITH_YOUR_SSH_PUBLIC_KEY
    rh_subscription:
      activation-key: REPLACE_ME
      org: REPLACE_ME
